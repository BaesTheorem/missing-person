#!/usr/bin/env python3
"""mp -- assist a public missing-person search from the command line.

    mp cases                  list every case found in the search directories
    mp status <case>          NCIC + NamUs case status, and the source conflicts
    mp unidentified <case>    rank unidentified-person candidates
    mp news <case>            newsroom feed sweep
    mp area <case>            terrain around each last-seen point
    mp scan <case>            all of the above, into a vault note
    mp watch <case>           scan, and notify ONLY on a change

Case files live outside this repo (a notes vault); see missing_person/case.py
for the search order, and cases/example.toml for the format.

Every source is public and read-only. Nothing here files, edits, or closes a
case, and nothing here identifies anyone: unidentified-person output is a
ranked list of leads for the investigating agency to evaluate.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from missing_person import case as case_mod
from missing_person import documents as docs_mod
from missing_person import geo, report, scan as scan_mod, state
from missing_person.match import rank
from missing_person.net import SourceError
from missing_person.sources import mshp, namus, news, usgs

NOTIFY = Path.home() / "Documents" / "Exobrain harness" / "mist-voice" / "bin" / "mist-notify"


def _notify(message: str, title: str, link: str) -> None:
    if not NOTIFY.exists():
        return
    subprocess.run([str(NOTIFY), message, title, "default", link], check=False)


def _case(args: argparse.Namespace) -> case_mod.Case:
    return case_mod.load(args.case)


def cmd_cases(_: argparse.Namespace) -> int:
    for name in case_mod.available():
        c = case_mod.load(name)
        print(f"{name:<20} {c.display_name} -- missing {report.days_missing(c)} days, {c.agency}")
    return 0


def _status(c: case_mod.Case) -> tuple[list[mshp.MissingListing], bool | None, str]:
    listings = mshp.search_missing(c.mshp_last, c.mshp_first)
    resolved: bool | None = None
    modified = ""
    if c.namus_mp:
        record = namus.missing_case(c.namus_mp)
        resolved = bool(record.get("caseIsResolved"))
        modified = str(record.get("modifiedDateTime") or "")
    return listings, resolved, modified


def cmd_status(args: argparse.Namespace) -> int:
    c = _case(args)
    listings, resolved, modified = _status(c)
    print(f"{c.display_name} -- day {report.days_missing(c)} of the search\n")
    for line in report.status_block(c, listings, resolved, modified):
        print(line.replace("- ", "  ").replace("**", ""))
    print("\n  Dates each source asserts:")
    for label, value in c.date_claims.items():
        print(f"    {label:<38} {value}")
    print("\n  Last-seen claims:")
    for loc in c.locations:
        print(f"    {loc.label:<28} {loc.lat:.4f}, {loc.lon:.4f} "
              f"+/-{loc.precision_mi}mi  ({loc.source})")
    for a, b, miles, meaningful in geo.separation(c.locations):
        verdict = "real gap" if meaningful else "INSIDE the combined uncertainty"
        print(f"    separation: {a} <-> {b} = {miles} mi ({verdict})")
    for a_label, a_zip, b_label, b_zip in geo.zip_conflicts(c.locations):
        print(f"    ZIP CONFLICT: {a_label} = {a_zip}, {b_label} = {b_zip}")
    return 0


def cmd_unidentified(args: argparse.Namespace) -> int:
    c = _case(args)
    states = None if args.national else (args.states or c.search_states)
    scope = "nationwide" if states is None else ", ".join(states)
    print(f"Sweeping NamUs unidentified persons ({scope}), "
          f"recovered on or after {c.recovery_floor}...")
    records = namus.unidentified(states, found_on_or_after=c.recovery_floor)
    print(f"  {len(records)} records in scope")
    candidates = rank(c, records, minimum=args.min)
    print(f"  {len(candidates)} consistent with the description "
          f"(score >= {args.min})\n")
    for cand in candidates[: args.limit]:
        r = cand.record
        ht = f"{r.height_in[0]}-{r.height_in[1]}in" if r.height_in else "ht ?"
        wt = f"{r.weight_lb[0]}-{r.weight_lb[1]}lb" if r.weight_lb else "wt ?"
        age = f"{r.age_est[0]}-{r.age_est[1]}y" if r.age_est else "age ?"
        print(f"  {cand.score:.2f} cov {cand.coverage:.0%} {cand.stars:<5} {r.case_id:<10} found "
              f"{r.date_found or '?'}  {r.city} {r.county} {r.state}")
        print(f"        {age}, {ht}, {wt}, {r.hair} hair, {r.eyes} eyes")
        print(f"        matched: {', '.join(cand.matched) or 'none'} | "
              f"unknown: {', '.join(cand.unknown) or 'none'}")
        print(f"        {r.url}")
        if cand.note:
            print(f"        note: {cand.note}")
        print()
    if candidates:
        print("  These are LEADS, not identifications. Route anything worth a look to")
        print(f"  {c.agency} at {c.agency_phones.get('missing_persons','')}, not to a")
        print("  medical examiner directly.")
    return 0


def cmd_docs(args: argparse.Namespace) -> int:
    c = _case(args)
    if not c.documents:
        print("No source documents listed for this case.")
        print("Add [[documents]] blocks to the case file; agency bulletins and")
        print("poster PDFs routinely carry detail that no API exposes.")
        return 0
    failed = 0
    for doc in c.documents:
        st = docs_mod.state(_doc(doc), c.id, c.cases_dir)
        try:
            st = docs_mod.ensure(_doc(doc), c.id, c.cases_dir, refetch=args.refetch)
        except SourceError as exc:
            print(f"  [FAILED] {doc.label}: {exc}")
            failed += 1
            continue
        text = st.text()
        print(f"\n== {doc.label} ==")
        print(f"   {doc.url}")
        print(f"   {st.path}  ({st.path.stat().st_size} bytes, "
              f"{len(text)} chars of text)")
        if args.show:
            print("   " + "\n   ".join(text.splitlines()[: args.lines]))
    return 2 if failed else 0


def _doc(d) -> docs_mod.Document:
    return docs_mod.Document(label=d.label, url=d.url, kind=d.kind, note=d.note)


def _document_warnings(c) -> list[str]:
    """Fetch anything new and report what could not be read.

    Loud on purpose. The whole reason this feature exists is that a cited
    document sat unread while every other source was being re-litigated.
    """
    out: list[str] = []
    for doc in c.documents:
        try:
            docs_mod.ensure(_doc(doc), c.id, c.cases_dir)
        except SourceError as exc:
            out.append(f"UNREAD SOURCE DOCUMENT: {doc.label} -- {exc}")
    return out


def cmd_news(args: argparse.Namespace) -> int:
    c = _case(args)
    try:
        articles = news.scan(c.news_terms, c.mshp_last, c.locality_terms)
    except SourceError as exc:
        print(f"feeds failed: {exc}", file=sys.stderr)
        return 2
    if not articles:
        print("No mentions in the watched feeds (KSHB, FOX4, Google News).")
        return 0
    for a in articles[: args.limit]:
        print(f"  {a.source}: {a.title}\n     {a.published}\n     {a.url}\n")
    return 0


def cmd_area(args: argparse.Namespace) -> int:
    c = _case(args)
    targets = c.search_locations if args.all_locations else c.search_locations[:1]
    if args.include_coarse:
        targets = c.locations if args.all_locations else [c.primary_location]
    failed: list[str] = []
    skipped = [loc for loc in c.locations if loc not in targets]
    for loc in skipped:
        print(f"   skipping {loc.label} (+/-{loc.precision_mi} mi): too coarse to "
              f"search around. Use --include-coarse to override.")
    if not targets:
        print("   No location in this case is precise enough to search around.")
        return 1
    for loc in targets:
        print(f"\n== {loc.label} ({loc.source}) -- {args.radius} mi radius ==")
        for label, url in geo.map_links(loc, args.radius).items():
            print(f"   {label}: {url}")
        produced = False
        # Water first, and from USGS rather than OSM. It is the federal
        # dataset, and it answered every request on an afternoon when all
        # three public Overpass endpoints were rate-limiting.
        try:
            water = usgs.water_near(loc.lat, loc.lon, args.radius)
            produced = True
            named = [w for w in water if w.name]
            print(f"\n   WATER (USGS NHD): {len(water)} features, {len(named)} named")
            for w in named:
                print(f"     {w.distance_mi:>5.2f} mi  {w.ftype:<30} {w.name}")
            print(f"     unnamed ponds/basins/channels, nearest {args.per_kind}:")
            for w in [x for x in water if not x.name][: args.per_kind]:
                print(f"     {w.distance_mi:>5.2f} mi  {w.ftype:<30} "
                      f"{w.lat:.5f}, {w.lon:.5f}")
            for ring in (0.5, 1.0):
                print(f"     within {ring} mi: "
                      f"{sum(1 for x in water if x.distance_mi <= ring)}")
        except SourceError as exc:
            print(f"   USGS hydrography unavailable: {exc}", file=sys.stderr)

        try:
            features = geo.features_near(loc, args.radius, kinds=args.kinds or None)
            produced = True
        except SourceError as exc:
            print(f"   Overpass unavailable: {exc}", file=sys.stderr)
            features = []
        if not produced:
            failed.append(loc.label)
            continue
        by_kind: dict[str, list[geo.Feature]] = {}
        for f in features:
            by_kind.setdefault(f.kind, []).append(f)
        for kind, items in by_kind.items():
            print(f"\n   {kind} ({len(items)})")
            for f in items[: args.per_kind]:
                print(f"     {f.distance_mi:>5.2f} mi  {f.name[:46]:<46} {f.osm}")
    print("\n   Terrain, not a prediction. Coordinate with the agency and with any")
    print("   organised search before walking private land.")
    if failed:
        # An analysis that produced nothing must not exit 0. This returned
        # success while every data source had failed, which is the exact
        # silent failure the rest of this toolkit is built to avoid.
        print(f"   NO DATA for: {', '.join(failed)}", file=sys.stderr)
        return 2
    return 0


def _report_failures(r: scan_mod.ScanResult) -> None:
    for source, err in r.failures.items():
        print(f"   !! {source} did not answer: {err[:160]}", file=sys.stderr)


def cmd_scan(args: argparse.Namespace) -> int:
    c = _case(args)
    warnings = _document_warnings(c)
    r = scan_mod.run(c)
    for warning in warnings:
        print(f"   !! {warning}", file=sys.stderr)
    _report_failures(r)
    print(report.terminal(c, r.listings, r.namus_resolved, r.candidates, r.articles,
                          r.news_candidates))
    body = report.render_note(c, r.listings, r.namus_resolved, r.namus_modified,
                              r.candidates, r.articles, datetime.now().astimezone(),
                              r.news_candidates)
    path = report.write_note(c, body)
    print(f"\n   note: {path}")
    return 2 if r.failures else 0


def cmd_watch(args: argparse.Namespace) -> int:
    """Run a scan and speak only when something actually changed.

    A source that did not answer is NOT read as 'no change' and NOT read as a
    change either. Its previous value is kept, the failure is counted, and a
    source that has failed on consecutive runs becomes a finding of its own.

    Exits non-zero on that finding, not on the single miss that produced it.
    One dropped request still prints to stderr and still lands in the launchd
    log; it just does not raise an alarm that the next run clears.
    """
    c = _case(args)
    st = state.load(c.id)
    r = scan_mod.run(c)
    _report_failures(r)
    changes: list[str] = []

    active = r.ncic_active(c)
    if active is not None:
        if st.ncic_active is not None and st.ncic_active != active:
            changes.append("NCIC listing went ACTIVE" if active
                           else "NCIC listing CLEARED -- call the agency")
        st.ncic_active = active
    if "namus_case" not in r.failures:
        if st.namus_resolved is not None and st.namus_resolved != r.namus_resolved:
            changes.append(f"NamUs resolved flag flipped to {r.namus_resolved}")
        if st.namus_modified and r.namus_modified[:19] != st.namus_modified[:19]:
            changes.append(f"NamUs record edited ({r.namus_modified[:10]})")
        st.namus_resolved = r.namus_resolved
        st.namus_modified = r.namus_modified
    if "news" not in r.failures:
        fresh = [a for a in r.articles if a.key not in set(st.seen_articles)]
        if fresh:
            changes.append(f"{len(fresh)} new article(s): {fresh[0].title[:70]}")
        st.seen_articles = list(dict.fromkeys(st.seen_articles + [a.key for a in r.articles]))
        # Strong candidates are surfaced on their own track, never folded into
        # `changes`: a confirmed mention and an unverified lead must not arrive
        # in the same words. Only the strong ones are recorded as seen, so a
        # weak candidate that later gains a corroboration still gets its turn.
        known = set(st.seen_news_candidates)
        new_strong = [c for c in scan_mod.strong_candidates(r)
                      if c.article.key not in known]
        st.seen_news_candidates = list(dict.fromkeys(
            st.seen_news_candidates + [c.article.key for c in new_strong]))
        # Timestamped, because the firing RATE is what decides whether the
        # two-agreement threshold is set right, and a bare count of seen keys
        # cannot answer that after the fact.
        for cand in new_strong:
            st.note("news_candidate",
                    f"[{', '.join(cand.corroborates)}] {cand.article.title[:90]}")
    else:
        new_strong = []
    if "namus_unidentified" not in r.failures:
        top = [cand.record.case_id for cand in r.candidates[:10]]
        new_candidates = [x for x in top if x not in set(st.top_candidates)]
        if new_candidates and st.top_candidates:
            changes.append(f"new unidentified candidate(s): {', '.join(new_candidates)}")
        st.top_candidates = top

    for source in ("mshp", "namus_case", "namus_unidentified", "news"):
        if source in r.failures:
            st.source_failures[source] = st.source_failures.get(source, 0) + 1
            if st.source_failures[source] >= state.ESCALATE_AFTER:
                changes.append(f"{source} has failed {st.source_failures[source]} runs running")
        else:
            st.source_failures[source] = 0

    for change in changes:
        st.note("change", change)
    st.save()

    body = report.render_note(c, r.listings, r.namus_resolved, r.namus_modified,
                              r.candidates, r.articles, datetime.now().astimezone(),
                              r.news_candidates)
    note_path = report.write_note(c, body)
    link = f"obsidian://open?vault=Exobrain&file={note_path.stem}"

    if changes:
        _notify(" | ".join(changes), f"{c.display_name}: case update", link)
        print("CHANGED:\n  " + "\n  ".join(changes))
    elif not new_strong:
        print(f"no change ({report.days_missing(c)} days missing)")

    for cand in new_strong[:3]:
        _notify(f"{cand.article.title[:110]} (agrees: "
                f"{', '.join(cand.corroborates)}; name not printed)",
                f"{c.display_name}: possible coverage, UNVERIFIED", link)
    if new_strong:
        print(f"POSSIBLE COVERAGE ({len(new_strong)}, unverified):")
        for cand in new_strong:
            print(f"  [{', '.join(cand.corroborates)}] {cand.article.title[:70]}")
    down = state.escalated(st)
    if down:
        print(f"   !! down {state.ESCALATE_AFTER}+ runs running: {', '.join(down)}",
              file=sys.stderr)
    return 2 if down else 0


def main() -> int:
    # Line-buffer stdout. `mp area` and `mp unidentified` print progress across
    # minutes of network work, and Python block-buffers stdout when it is not a
    # tty. Redirected to a log or captured by a watcher, that made a slow run
    # look identical to a hung one for 25 minutes.
    sys.stdout.reconfigure(line_buffering=True)
    p = argparse.ArgumentParser(prog="mp", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("cases", help="list configured cases").set_defaults(fn=cmd_cases)

    def with_case(name: str, help_text: str) -> argparse.ArgumentParser:
        sp = sub.add_parser(name, help=help_text)
        sp.add_argument("case")
        return sp

    with_case("status", "NCIC + NamUs status").set_defaults(fn=cmd_status)

    sp = with_case("unidentified", "rank unidentified-person candidates")
    sp.add_argument("--national", action="store_true", help="sweep all states")
    sp.add_argument("--states", nargs="*", help="override the case's state list")
    sp.add_argument("--min", type=float, default=0.5, help="minimum score")
    sp.add_argument("--limit", type=int, default=25)
    sp.set_defaults(fn=cmd_unidentified)

    sp = with_case("news", "newsroom feed sweep")
    sp.add_argument("--limit", type=int, default=20)
    sp.set_defaults(fn=cmd_news)

    sp = with_case("area", "terrain around the last-seen point")
    sp.add_argument("--radius", type=float, default=2.0, help="miles")
    sp.add_argument("--per-kind", type=int, default=8)
    sp.add_argument("--kinds", nargs="*", choices=list(geo.FEATURE_QUERIES))
    sp.add_argument("--all-locations", action="store_true",
                    help="every searchable last-seen claim, not just the first")
    sp.add_argument("--include-coarse", action="store_true",
                    help="also map around centroid-precision points (rarely useful)")
    sp.set_defaults(fn=cmd_area)

    sp = with_case("docs", "fetch and read the case's source documents")
    sp.add_argument("--show", action="store_true", help="print extracted text")
    sp.add_argument("--lines", type=int, default=40)
    sp.add_argument("--refetch", action="store_true")
    sp.set_defaults(fn=cmd_docs)

    with_case("scan", "full sweep into an Obsidian note").set_defaults(fn=cmd_scan)
    with_case("watch", "scan, notify only on change").set_defaults(fn=cmd_watch)

    args = p.parse_args()
    try:
        return int(args.fn(args))
    except SourceError as exc:
        print(f"source error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
